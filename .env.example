# API тохиргоо. Энэ файлыг .env.local нэрээр хуулж, бодит утгуудаа оруулна (.env.local нь git-д орохгүй).

# Chatbot-ийн Gemini тохиргоо. Жинхэнэ key-г энэ файлд хэзээ ч commit хийхгүй.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Бусад endpoint-үүдийн mock тохиргоо.
# Backend бэлэн болоход false болгоно.
VITE_USE_MOCK=true

# Supabase Auth (VITE_USE_MOCK=false үед жинхэнэ нэвтрэлт). Publishable key л орно, secret key хэзээ ч бүү тавь.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API-ийн үндсэн хаяг (VITE_USE_MOCK=false үед).
# Жишээ: http://localhost:4000/api эсвэл https://api.magiccode.mn/api
VITE_API_URL=/api
