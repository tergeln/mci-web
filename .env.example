# API тохиргоо. Энэ файлыг .env нэрээр хуулж, утгуудаа өөрчилнө (.env нь git-д орохгүй).

# true (эсвэл хоосон) бол backend-гүйгээр src/api/mock доторх хуурамч өгөгдлийг ашиглана.
# Backend бэлэн болоход false болгоно.
VITE_USE_MOCK=true

# Backend API-ийн үндсэн хаяг (VITE_USE_MOCK=false үед).
# Жишээ: http://localhost:4000/api эсвэл https://api.magiccode.mn/api
VITE_API_URL=/api
