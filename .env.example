# API тохиргоо. Энэ файлыг .env.local нэрээр хуулж, бодит утгуудаа оруулна (.env.local нь git-д орохгүй).

# Magi чатбот (mci-chatbot repo-гийн API). Gemini түлхүүр зөвхөн тэр API-д байна.
# Локал дээр: http://localhost:8000
VITE_CHAT_API_URL=https://magiccode-chatbot.vercel.app

# Бусад endpoint-үүдийн mock тохиргоо.
# Backend бэлэн болоход false болгоно.
VITE_USE_MOCK=true

# Backend API-ийн үндсэн хаяг (VITE_USE_MOCK=false үед).
# Жишээ: http://localhost:4000/api эсвэл https://api.magiccode.mn/api
VITE_API_URL=/api
